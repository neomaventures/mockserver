{
  "name": "@neomaventures/mockserver",
  "version": "0.1.0",
  "description": "A typed client for MockServer's REST API. Stub and verify HTTP expectations from your tests; container lifecycle stays with your harness.",
  "type": "commonjs",
  "author": "Daniel Bruce",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neomaventures/mockserver.git"
  },
  "bugs": {
    "url": "https://github.com/neomaventures/mockserver/issues"
  },
  "homepage": "https://github.com/neomaventures/mockserver#readme",
  "keywords": [
    "mockserver",
    "mock",
    "http",
    "testing",
    "e2e",
    "expectations",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixture": {
      "types": "./dist/fixture.d.ts",
      "default": "./dist/fixture.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!**/*.json",
    "!**/*.tsbuildinfo"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p ./tsconfig.lib.json",
    "test": "jest --runInBand --passWithNoTests",
    "pretest:e2e": "pnpm build && docker compose up -d --wait",
    "test:e2e": "node --env-file=.env.e2e ./node_modules/jest/bin/jest.js --config ./e2e/jest-e2e.json --runInBand",
    "posttest:e2e": "docker compose down",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:package": "pnpm build && publint && attw --pack",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^9.6.0",
    "@neomaventures/wait-for": "^0.0.1",
    "@swc/core": "^1.12.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-jest-extended": "^3.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-yml": "^3.3.2",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-extended": "^7.0.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">=22"
  },
  "typesVersions": {
    "*": {
      "fixture": [
        "dist/fixture.d.ts"
      ]
    }
  }
}
